PORT=3000
# Crée une application REST dans https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=COLLE_ICI_TON_CLIENT_ID
PAYPAL_CLIENT_SECRET=COLLE_ICI_TON_SECRET
# sandbox pour tester sans vrais paiements ; live pour les paiements réels
PAYPAL_MODE=sandbox
# URL publique du site, utilisée si tu ajoutes ensuite des protections de domaine
SITE_URL=http://localhost:3000

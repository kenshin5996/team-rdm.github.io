PORT=3000
# Crée une application REST dans https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=COLLE_ICI_TON_CLIENT_ID
PAYPAL_CLIENT_SECRET=COLLE_ICI_TON_SECRET
# sandbox pour tester sans vrais paiements ; live pour les paiements réels
PAYPAL_MODE=sandbox
# URL publique du site, utilisée si tu ajoutes ensuite des protections de domaine
SITE_URL=http://localhost:3000

# Authentification membre Discord + Twitch (obligatoire pour activer la connexion)
# Crée les applications dans https://discord.com/developers/applications et https://dev.twitch.tv/console/apps
SESSION_SECRET=REMPLACER_PAR_UNE_LONGUE_CLE_ALEATOIRE
DISCORD_CLIENT_ID=COLLE_ICI_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=COLLE_ICI_DISCORD_CLIENT_SECRET
TWITCH_CLIENT_ID=COLLE_ICI_TWITCH_CLIENT_ID
TWITCH_CLIENT_SECRET=COLLE_ICI_TWITCH_CLIENT_SECRET
# URL publique exacte du site Node (sans slash final), ex. https://team-rdm.example.com
SITE_URL=http://localhost:3000
# Liste des pseudos Twitch officiels autorisés, séparés par des virgules
TEAM_MEMBER_TWITCH_LOGINS=kenshin5996,c_djo,manimang0,fandeipromxtrollmod,theoherlintw,maszoks
